<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smarthome.controller.LogController"
      stylesheets="@../css/style.css"
      prefWidth="420" prefHeight="500" spacing="8"
      styleClass="side-panel">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <Label text="ЖУРНАЛ ЛОГИРОВАНИЯ" styleClass="app-title"/>
    <Label text="Действия устройств с включённым логированием (Decorator)"
           styleClass="panel-title" wrapText="true"/>

    <TextArea fx:id="logArea" VBox.vgrow="ALWAYS"
              styleClass="log-area"
              promptText="Записей пока нет..."/>

    <Button text="Очистить журнал" onAction="#onClear"
            styleClass="btn-secondary" maxWidth="Infinity"/>
</VBox>
