<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.smarthome.view.component.Room3DView?>
<?import com.smarthome.view.component.RoomCanvas?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarthome.controller.MainController"
            stylesheets="@../css/style.css"
            prefWidth="1100" prefHeight="700">

    <!-- Боковое меню слева: комнаты и переключение окон -->
    <left>
        <VBox prefWidth="240" styleClass="side-panel" spacing="8">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <Label text="УМНЫЙ ДОМ" styleClass="app-title"/>

            <!-- Режимы просмотра -->
            <HBox spacing="6">
                <Button text="2D" onAction="#onSwitch2D" styleClass="btn-secondary"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="3D" onAction="#onSwitch3D" styleClass="btn-secondary"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="FPS" onAction="#onSwitchFps" styleClass="btn-secondary"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <Separator/>

            <Label text="Комнаты" styleClass="panel-title"/>
            <ListView fx:id="roomListView" prefHeight="220" styleClass="dark-list" VBox.vgrow="ALWAYS"/>

            <HBox spacing="6">
                <Button text="+ Комната" onAction="#onAddRoom" styleClass="btn-primary"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="−" onAction="#onRemoveRoom" styleClass="btn-danger" prefWidth="36"/>
            </HBox>

            <Separator/>

            <!-- Кнопки открытия/закрытия дополнительных окон -->
            <Label text="Панели" styleClass="panel-title"/>
            <Button text="Устройства" onAction="#onToggleDevicePanel"
                    styleClass="btn-secondary" maxWidth="Infinity"/>
            <Button text="Автоматизация" onAction="#onToggleAutomation"
                    styleClass="btn-secondary" maxWidth="Infinity"/>
            <Button text="Журнал логирования" onAction="#onToggleLog"
                    styleClass="btn-secondary" maxWidth="Infinity"/>

            <Separator/>

            <Label text="3D Модели" styleClass="panel-title"/>
            <Button text="Загрузить .obj модель" onAction="#onLoadObjModel"
                    styleClass="btn-secondary" maxWidth="Infinity"/>
            <Button text="Убрать все модели" onAction="#onClearObjModels"
                    styleClass="btn-secondary" maxWidth="Infinity"/>

            <Separator/>

            <Button text="Выход" onAction="#onExit" styleClass="btn-danger" maxWidth="Infinity"/>

            <Label fx:id="houseInfoLabel" text="0 комнат" styleClass="house-info" wrapText="true"/>
        </VBox>
    </left>

    <!-- Центр: 2D или 3D вид -->
    <center>
        <StackPane>
            <RoomCanvas fx:id="roomCanvas" visible="false"/>
            <Room3DView fx:id="room3DView"/>
        </StackPane>
    </center>

    <!-- Статусная строка -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
            <Label fx:id="statusLabel" text="Готово"/>
        </HBox>
    </bottom>

</BorderPane>
